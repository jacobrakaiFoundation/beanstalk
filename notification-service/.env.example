HOST=0.0.0.0
PORT=8787
DATABASE_PATH=/data/beanstalk-notifications.sqlite
FDA_RSS_URL=https://www.fda.gov/about-fda/contact-fda/stay-informed/rss-feeds/food-safety-recalls/rss.xml
# At year rollover, add the prior-year official XML URL after a comma.
FDA_ANNUAL_XML_URLS=https://www.fda.gov/media/191968/download?attachment=
POLL_INTERVAL_MS=900000
QUEUE_INTERVAL_MS=5000
DELIVERY_RETENTION_DAYS=30
POLL_STALE_AFTER_MS=2100000
ANNOUNCEMENT_FETCH_CONCURRENCY=4
LOG_LEVEL=info
TRUST_PROXY=1

# Leave all four unset until App Store/APNs credentials are available.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY_PATH=

# Leave both unset until Firebase Cloud Messaging server credentials are available.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=
FCM_ANDROID_PACKAGE_NAME=org.jacobrakaifoundation.beanstalk
